  "components": {
    "schemas": {
      "APIErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "APIErrorDetail",
        "description": "Stable error code, message, and optional request context."
      },
      "APIErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/APIErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "APIErrorResponse",
        "description": "Envelope used by expected API failures."
      },
      "ClueRequest": {
        "properties": {
          "puzzleId": {
            "type": "string",
            "minLength": 1,
            "title": "Puzzleid"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "title": "Sessionid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "daily",
              "practice"
            ],
            "title": "Mode"
          },
          "lang": {
            "type": "string",
            "title": "Lang"
          },
          "currentBoardWords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Currentboardwords"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "puzzleId",
          "sessionId",
          "mode",
          "lang",
          "currentBoardWords"
        ],
        "title": "ClueRequest",
        "description": "Clue request for a puzzle and current board."
      },
      "ClueResponse": {
        "properties": {
          "puzzleId": {
            "type": "string",
            "title": "Puzzleid"
          },
          "word": {
            "type": "string",
            "title": "Word"
          },
          "fromWord": {
            "type": "string",
            "title": "Fromword"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "puzzleId",
          "word",
          "fromWord"
        ],
        "title": "ClueResponse",
        "description": "One unused word from a known valid path."
      },
      "EdgeResponse": {
        "properties": {
          "wordA": {
            "type": "string",
            "title": "Worda"
          },
          "wordB": {
            "type": "string",
            "title": "Wordb"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          },
          "nearMiss": {
            "type": "boolean",
            "title": "Nearmiss"
          },
          "retained": {
            "type": "boolean",
            "title": "Retained"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "wordA",
          "wordB",
          "weight",
          "nearMiss",
          "retained"
        ],
        "title": "EdgeResponse",
        "description": "Scored edge returned for the submitted word."
      },
      "FastestSolve": {
        "properties": {
          "place": {
            "type": "integer",
            "title": "Place"
          },
          "lang": {
            "type": "string",
            "title": "Lang"
          },
          "pathLength": {
            "type": "integer",
            "title": "Pathlength"
          },
          "guessCount": {
            "type": "integer",
            "title": "Guesscount"
          },
          "durationMs": {
            "type": "integer",
            "title": "Durationms"
          },
          "solvedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Solvedat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "place",
          "lang",
          "pathLength",
          "guessCount",
          "durationMs",
          "solvedAt"
        ],
        "title": "FastestSolve",
        "description": "Privacy-safe leaderboard row with no session identifier."
      },
      "GuessRequest": {
        "properties": {
          "puzzleId": {
            "type": "string",
            "minLength": 1,
            "title": "Puzzleid"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "title": "Sessionid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "daily",
              "practice"
            ],
            "title": "Mode"
          },
          "lang": {
            "type": "string",
            "title": "Lang"
          },
          "word": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Word"
          },
          "currentBoardWords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Currentboardwords"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "puzzleId",
          "sessionId",
          "mode",
          "lang",
          "word",
          "currentBoardWords"
        ],
        "title": "GuessRequest",
        "description": "One word submission with the client's current board."
      },
      "GuessResponse": {
        "properties": {
          "puzzleId": {
            "type": "string",
            "title": "Puzzleid"
          },
          "lang": {
            "type": "string",
            "title": "Lang"
          },
          "word": {
            "type": "string",
            "title": "Word"
          },
          "normalized": {
            "type": "string",
            "title": "Normalized"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/EdgeResponse"
            },
            "type": "array",
            "title": "Edges"
          },
          "prunedEdges": {
            "items": {
              "$ref": "#/components/schemas/EdgeResponse"
            },
            "type": "array",
            "title": "Prunededges"
          },
          "connected": {
            "type": "boolean",
            "title": "Connected"
          },
          "path": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "puzzleId",
          "lang",
          "word",
          "normalized",
          "edges",
          "prunedEdges",
          "connected",
          "path",
          "score"
        ],
        "title": "GuessResponse",
        "description": "Validation, edge, win, and scoring results."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlaytestFeedbackItem": {
        "properties": {
          "puzzleId": {
            "type": "string",
            "minLength": 1,
            "title": "Puzzleid"
          },
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating"
          },
          "feedback": {
            "type": "string",
            "maxLength": 1000,
            "title": "Feedback",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "puzzleId",
          "rating"
        ],
        "title": "PlaytestFeedbackItem",
        "description": "One rating and optional note for a reviewed puzzle."
      },
      "PlaytestFeedbackRequest": {
        "properties": {
          "lang": {
            "type": "string",
            "title": "Lang"
          },
          "isNativeSpeaker": {
            "type": "boolean",
            "title": "Isnativespeaker"
          },
          "responses": {
            "items": {
              "$ref": "#/components/schemas/PlaytestFeedbackItem"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 10,
            "title": "Responses"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lang",
          "isNativeSpeaker",
          "responses"
        ],
        "title": "PlaytestFeedbackRequest",
        "description": "Native-speaker feedback for exactly ten puzzles in one language."
      },
      "PlaytestFeedbackResponse": {
        "properties": {
          "lang": {
            "type": "string",
            "title": "Lang"
          },
          "submitted": {
            "type": "integer",
            "title": "Submitted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lang",
          "submitted"
        ],
        "title": "PlaytestFeedbackResponse",
        "description": "Feedback batch insertion result."
      },
      "PlaytestPuzzle": {
        "properties": {
          "puzzleId": {
            "type": "string",
            "title": "Puzzleid"
          },
          "lang": {
            "type": "string",
            "title": "Lang"
          },
          "anchorA": {
            "type": "string",
            "title": "Anchora"
          },
          "anchorB": {
            "type": "string",
            "title": "Anchorb"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "puzzleId",
          "lang",
          "anchorA",
          "anchorB"
        ],
        "title": "PlaytestPuzzle",
        "description": "Minimal puzzle details rendered by the internal feedback form."
      },
      "PlaytestPuzzlesResponse": {
        "properties": {
          "lang": {
            "type": "string",
            "title": "Lang"
          },
          "puzzles": {
            "items": {
              "$ref": "#/components/schemas/PlaytestPuzzle"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 10,
            "title": "Puzzles"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lang",
          "puzzles"
        ],
        "title": "PlaytestPuzzlesResponse",
        "description": "Ten selected puzzles for one native-speaker language review."
      },
