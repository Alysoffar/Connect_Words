# Generate a long random value before deployment; never commit the real token.
LINKWORDS_ADMIN_TOKEN=replace-with-a-long-random-secret
LINKWORDS_CORS_ORIGINS=http://localhost:3000
LINKWORDS_HOST_DATA_DIR=./data
NEXT_PUBLIC_API_URL=http://localhost:8000
LINKWORDS_SLOW_GUESS_THRESHOLD=35

# Optional webhook for daily queue alerts. The rollover container logs alerts
# even when no webhook is configured.
LINKWORDS_ALERT_WEBHOOK_URL=
