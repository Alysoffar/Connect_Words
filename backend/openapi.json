{
  "openapi": "3.1.0",
  "info": {
    "title": "LinkWords API",
    "description": "Multilingual word-association gameplay API. Vocabulary, vectors, lexical scores, and puzzle records load at startup; anonymous session analytics and accepted guesses persist in SQLite.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/puzzle/daily": {
      "get": {
        "summary": "Daily Puzzle",
        "operationId": "daily_puzzle_api_puzzle_daily_get",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Lang"
            }
          },
          {
            "name": "sessionId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sessionid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PuzzleResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        }
      }
    },
